# Copy this file to backend/.env and fill in real values.
# The .env file is gitignored — never commit secrets.

# Gemini (used for tagging, outfit generation, and the shopping agent).
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.1-flash-lite

# Supabase Postgres connection string. From the Supabase dashboard:
# Project Settings → Database → Connection string (transaction pooler works,
# port 6543). sslmode=require is appended automatically if absent.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres